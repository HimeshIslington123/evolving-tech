generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  ADMIN
  STAFF
  VENDOR
  RIDER
}

// ======================================================
// RETURN ENUMS
// ======================================================

enum ReturnStatus {
  REQUESTED
  ASSIGNED_TO_RIDER
  PICKED_UP_FROM_CUSTOMER
  IN_WAREHOUSE
  OUT_FOR_RETURN
  RETURNED_TO_VENDOR
  CANCELLED
}

enum ReturnReason {
  CUSTOMER_CHANGED_MIND
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  DEFECTIVE_PRODUCT
  WRONG_SIZE
  WRONG_COLOR
  PRODUCT_NOT_AS_DESCRIBED
  OTHER
}

// ======================================================
// PICKUP ENUM
// ======================================================

enum PickupStatus {
  REQUESTED
  ASSIGNED
  PICKUP_DONE
  CANCELLED
}

// ======================================================
// SHIPMENT ENUMS
// ======================================================

enum ShipmentOrigin {
  VENDOR
  STAFF
}

enum DeliveryZone {
  INSIDE_VALLEY
  OUTSIDE_VALLEY
}

enum ShipmentStatus {
  CREATED
  IN_WAREHOUSE
  ASSIGNED_TO_RIDER
  OUT_FOR_DELIVERY
  DELIVERED

  RETURN_REQUESTED
  RETURN_ASSIGNED_TO_RIDER
  RETURN_PICKED_UP_FROM_CUSTOMER
  RETURN_IN_WAREHOUSE
  OUT_FOR_RETURN
  RETURNED_TO_VENDOR

  CANCELLED
}

enum PackageType {
  DOCUMENT
  PARCEL
  BOX
  ELECTRONICS
  CLOTHING
  FOOD
  FRAGILE
  OTHER
}

enum PaymentType {
  PREPAID
  COD
}

// ======================================================
// USER
// ======================================================

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  role     Role
  isActive Boolean @default(true)

  vendor Vendor?
  rider  Rider?
  staff  Staff?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// VENDOR
// ======================================================

model Vendor {
  id Int @id @default(autoincrement())

  companyName String
  contactId   String
  location    String

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  shipments Shipment[]

  pickups Pickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// STAFF
// ======================================================

model Staff {
  id Int @id @default(autoincrement())

  phone          String
  profilePicture String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  createdShipments Shipment[] @relation("CreatedByStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// RIDER
// ======================================================

model Rider {
  id Int @id @default(autoincrement())

  phone          String
  profilePicture String?

  latitude  Float?
  longitude Float?

  isAvailable Boolean @default(true)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  shipments Shipment[]

  locations RiderLocation[]

  pickups Pickup[]

  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// PICKUP
// ======================================================

model Pickup {
  id Int @id @default(autoincrement())

  totalPackages Int

  pickupAddress String
  pickupPhone   String

  status PickupStatus @default(REQUESTED)

  notes String?

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  riderId Int?
  rider   Rider? @relation(fields: [riderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([riderId])
}

// ======================================================
// LOCATION
// ======================================================

model Location {
  id Int @id @default(autoincrement())

  name String @unique

  zone DeliveryZone

  rates LocationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// DELIVERY TYPE
// ======================================================

model DeliveryType {
  id Int @id @default(autoincrement())

  name String @unique

  rates LocationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// LOCATION RATE
// ======================================================

model LocationRate {
  id Int @id @default(autoincrement())

  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  deliveryTypeId Int
  deliveryType   DeliveryType @relation(fields: [deliveryTypeId], references: [id])

  price Float

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, deliveryTypeId])
}

// ======================================================
// WAREHOUSE
// ======================================================

model Warehouse {
  id Int @id @default(autoincrement())

  name String
  city String

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CARRIER
// ======================================================

model Carrier {
  id Int @id @default(autoincrement())

  name  String
  phone String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SHIPMENT
// ======================================================

model Shipment {
  id String @id @default(cuid())

  trackingNumber String @unique

  receiverName    String
  receiverPhone   String
  receiverAddress String

  packageType PackageType
  weight      Float

  paymentType PaymentType @default(PREPAID)
  codAmount   Float       @default(0)

  shippingCharge Float

  notes  String?
  qrCode String?

  origin ShipmentOrigin

  deliveryZone DeliveryZone?

  status ShipmentStatus @default(CREATED)

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  createdByStaffId Int?
  createdByStaff   Staff? @relation("CreatedByStaff", fields: [createdByStaffId], references: [id])

  riderId Int?
  rider   Rider? @relation(fields: [riderId], references: [id])

  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  carrierId Int?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])

  locationRateId Int
  locationRate   LocationRate @relation(fields: [locationRateId], references: [id])

  trackings Tracking[]

  returnRequest ReturnRequest?

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([riderId])
  @@index([warehouseId])
  @@index([carrierId])
}

// ======================================================
// RETURN REQUEST
// ======================================================
//
// SAME SHIPMENT
// SAME TRACKING NUMBER
// SAME TRACKING TABLE
//
// NO returnTrackingNumber
//
// ======================================================

model ReturnRequest {
  id String @id @default(cuid())

  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  status ReturnStatus @default(REQUESTED)

  reason ReturnReason

  description String?

  riderId Int?
  rider   Rider? @relation(fields: [riderId], references: [id])

  returnCharge Float @default(0)

  requestedAt DateTime @default(now())

  pickedUpAt DateTime?

  completedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([riderId])
}

// ======================================================
// TRACKING
// ======================================================
//
// ORIGINAL + RETURN TRACKING
//
// SAME shipmentId
// SAME Shipment.trackingNumber
//
// ======================================================

model Tracking {
  id String @id @default(cuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  status ShipmentStatus

  location String

  message String

  createdBy String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
}

// ======================================================
// RIDER LOCATION
// ======================================================

model RiderLocation {
  id Int @id @default(autoincrement())

  riderId Int
  rider   Rider @relation(fields: [riderId], references: [id])

  latitude  Float
  longitude Float

  createdAt DateTime @default(now())

  @@index([riderId])
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id Int @id @default(autoincrement())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([shipmentId])
}
