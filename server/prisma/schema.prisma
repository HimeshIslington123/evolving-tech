generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  ADMIN
  STAFF
  VENDOR
  RIDER
}
enum VehicleType {
  MOTORCYCLE
  SCOOTER
  CAR
  VAN
  TRUCK
  BICYCLE
  OTHER
}
// ======================================================
// SETTLEMENT
// ======================================================

enum SettlementDirection {
  PAY_VENDOR
  COLLECT_FROM_VENDOR
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
}

// ======================================================
// RETURN
// ======================================================

enum ReturnStatus {
  REQUESTED
  ASSIGNED_TO_RIDER
  PICKED_UP_FROM_CUSTOMER
  IN_WAREHOUSE
  OUT_FOR_RETURN
  RETURNED_TO_VENDOR
  CANCELLED
}

enum ReturnReason {
  CUSTOMER_CHANGED_MIND
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  DEFECTIVE_PRODUCT
  WRONG_SIZE
  WRONG_COLOR
  PRODUCT_NOT_AS_DESCRIBED
  OTHER
}

enum ReturnDeliveryOption {
  VENDOR_PICKUP
  DELIVER_TO_VENDOR
}

enum ReturnChargeType {
  NO_CHARGE
  CHARGE
}

enum ReturnChargePayer {
  CUSTOMER
  VENDOR
  COMPANY
}

// ======================================================
// PICKUP
// ======================================================

enum PickupStatus {
  REQUESTED
  ASSIGNED
  PICKUP_DONE
  CANCELLED
}

// ======================================================
// SHIPMENT
// ======================================================

enum ShipmentOrigin {
  VENDOR
  STAFF
}

enum DeliveryZone {
  INSIDE_VALLEY
  OUTSIDE_VALLEY
}

enum ShipmentStatus {
  CREATED
  IN_WAREHOUSE
  ASSIGNED_TO_RIDER
  OUT_FOR_DELIVERY
  DELIVERED

  RETURN_REQUESTED
  RETURN_ASSIGNED_TO_RIDER
  RETURN_PICKED_UP_FROM_CUSTOMER
  RETURN_IN_WAREHOUSE
  OUT_FOR_RETURN
  RETURNED_TO_VENDOR

  CANCELLED
}

enum PackageType {
  DOCUMENT
  PARCEL
  BOX
  ELECTRONICS
  CLOTHING
  FOOD
  FRAGILE
  OTHER
}

enum PaymentType {
  PREPAID
  COD
}

// ======================================================
// COD
// ======================================================

enum CodCollectionStatus {
  PENDING
  COLLECTED
  FAILED
  CANCELLED
}

// ======================================================
// ACCOUNTING
// ======================================================

enum AccountingEntryType {
  COD_COLLECTION
  SHIPPING_CHARGE
  RETURN_CHARGE
  PICKUP_CHARGE
  STORAGE_CHARGE
  OTHER_CHARGE
  REFUND
  VENDOR_SETTLEMENT
}

enum AccountingDirection {
  CREDIT
  DEBIT
}

// ======================================================
// USER
// ======================================================

model User {
  id Int @id @default(autoincrement())

  name String
  email String @unique
  password String

  role Role
  isActive Boolean @default(true)

  vendor Vendor?
  rider Rider?
  staff Staff?

  returnChargesSet ReturnRequest[] @relation("ReturnChargeSetBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// VENDOR
// ======================================================

model Vendor {
  id Int @id @default(autoincrement())

  companyName String
  contactId String
  location String

  // true  = registered vendor with login/account
  // false = unregistered vendor / guest business
  isRegistered Boolean @default(true)   

  // NULL for unregistered vendors
  userId Int? @unique
  user User? @relation(fields: [userId], references: [id])

  shipments Shipment[]
  pickups Pickup[]

  accountingEntries AccountingEntry[]
  settlements VendorSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRegistered])
}

// ======================================================
// STAFF
// ======================================================

model Staff {
  id Int @id @default(autoincrement())

  phone String
  profilePicture String?

  userId Int @unique
  user User @relation(fields: [userId], references: [id])

  createdShipments Shipment[] @relation("CreatedByStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// RIDER
// ======================================================

model Rider {
  id Int @id @default(autoincrement())

  phone String
  profilePicture String?

  // Vehicle information - optional
  vehicleType VehicleType?
  vehicleNumber String?
  vehicleBrand String?
  vehicleModel String?

  latitude Float?
  longitude Float?

  isAvailable Boolean @default(true)

  userId Int @unique
  user User @relation(fields: [userId], references: [id])

  shipments Shipment[]

  locations RiderLocation[]

  pickups Pickup[]

  returnPickupRequests ReturnRequest[] @relation("ReturnPickupRider")

  returnDeliveryRequests ReturnRequest[] @relation("ReturnDeliveryRider")

  codCollections CodCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ======================================================
// PICKUP
// ======================================================

model Pickup {
  id Int @id @default(autoincrement())

  totalPackages Int

  pickupAddress String
  pickupPhone String

  status PickupStatus @default(REQUESTED)

  notes String?

  vendorId Int
  vendor Vendor @relation(fields: [vendorId], references: [id])

  riderId Int?
  rider Rider? @relation(fields: [riderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([riderId])
}

// ======================================================
// LOCATION
// ======================================================

model Location {
  id Int @id @default(autoincrement())

  name String @unique

  zone DeliveryZone

  rates LocationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// DELIVERY TYPE
// ======================================================

model DeliveryType {
  id Int @id @default(autoincrement())

  name String @unique

  rates LocationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// LOCATION RATE
// ======================================================

model LocationRate {
  id Int @id @default(autoincrement())

  locationId Int
  location Location @relation(fields: [locationId], references: [id])

  deliveryTypeId Int
  deliveryType DeliveryType @relation(fields: [deliveryTypeId], references: [id])

  price Decimal @db.Decimal(12, 2)

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, deliveryTypeId])
}

// ======================================================
// WAREHOUSE
// ======================================================

model Warehouse {
  id Int @id @default(autoincrement())

  name String
  city String

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CARRIER
// ======================================================

model Carrier {
  id Int @id @default(autoincrement())

  name String
  phone String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SHIPMENT
// ======================================================

model Shipment {
  id String @id @default(cuid())

  trackingNumber String @unique

  senderName String
  senderPhone String
  senderAddress String

  receiverName String
  receiverPhone String
  receiverAddress String

  packageType PackageType
  weight Float

  paymentType PaymentType @default(PREPAID)

  codAmount Decimal @default(0) @db.Decimal(12, 2)

  shippingCharge Decimal @db.Decimal(12, 2)

  notes String?
  qrCode String?

  origin ShipmentOrigin

  deliveryZone DeliveryZone?

  status ShipmentStatus @default(CREATED)

  vendorId Int?
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  createdByStaffId Int?
  createdByStaff Staff? @relation("CreatedByStaff", fields: [createdByStaffId], references: [id])

  riderId Int?
  rider Rider? @relation(fields: [riderId], references: [id])

  warehouseId Int?
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  carrierId Int?
  carrier Carrier? @relation(fields: [carrierId], references: [id])

  locationRateId Int
  locationRate LocationRate @relation(fields: [locationRateId], references: [id])

  trackings Tracking[]

  returnRequest ReturnRequest?

  codCollection CodCollection?

  accountingEntries AccountingEntry[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([riderId])
  @@index([warehouseId])
  @@index([carrierId])
  @@index([locationRateId])
  @@index([trackingNumber])
}

// ======================================================
// RETURN REQUEST
// ======================================================

model ReturnRequest {
  id String @id @default(cuid())

  shipmentId String @unique
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  status ReturnStatus @default(REQUESTED)

  reason ReturnReason
  description String?

  riderId Int?
  rider Rider? @relation("ReturnPickupRider", fields: [riderId], references: [id])

  returnDeliveryRiderId Int?
  returnDeliveryRider Rider? @relation("ReturnDeliveryRider", fields: [returnDeliveryRiderId], references: [id])

  deliveryOption ReturnDeliveryOption?

  returnChargeType ReturnChargeType?

  returnChargePayer ReturnChargePayer?

  returnCharge Decimal @default(0) @db.Decimal(12, 2)

  chargeSetById Int?
  chargeSetBy User? @relation("ReturnChargeSetBy", fields: [chargeSetById], references: [id])

  chargeSetAt DateTime?

  requestedAt DateTime @default(now())

  pickedUpAt DateTime?

  completedAt DateTime?

  notes String?

  accountingEntries AccountingEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([riderId])
  @@index([returnDeliveryRiderId])
  @@index([deliveryOption])
  @@index([returnChargeType])
  @@index([returnChargePayer])
}

// ======================================================
// COD COLLECTION
// ======================================================

model CodCollection {
  id String @id @default(cuid())

  shipmentId String @unique
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  riderId Int?
  rider Rider? @relation(fields: [riderId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  status CodCollectionStatus @default(PENDING)

  collectedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([riderId])
}

// ======================================================
// ACCOUNTING ENTRY
// ======================================================

model AccountingEntry {
  id String @id @default(cuid())

  vendorId Int
  vendor Vendor @relation(fields: [vendorId], references: [id])

  shipmentId String?
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  returnRequestId String?
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  type AccountingEntryType

  direction AccountingDirection

  amount Decimal @db.Decimal(12, 2)

  description String?

  settlementItems SettlementItem[]

  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([shipmentId])
  @@index([returnRequestId])
  @@index([type])
  @@index([direction])
}

// ======================================================
// VENDOR SETTLEMENT
// ======================================================

model VendorSettlement {
  id String @id @default(cuid())

  vendorId Int
  vendor Vendor @relation(fields: [vendorId], references: [id])

  totalCodAmount Decimal @default(0) @db.Decimal(12, 2)

  totalShippingCharge Decimal @default(0) @db.Decimal(12, 2)

  totalReturnCharge Decimal @default(0) @db.Decimal(12, 2)

  totalOtherCharges Decimal @default(0) @db.Decimal(12, 2)

  totalCredits Decimal @default(0) @db.Decimal(12, 2)

  totalDebits Decimal @default(0) @db.Decimal(12, 2)

  netPayable Decimal @default(0) @db.Decimal(12, 2)

  direction SettlementDirection

  status SettlementStatus @default(PENDING)

  paidAt DateTime?

  paymentReference String?

  notes String?

  items SettlementItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([direction])
}

// ======================================================
// SETTLEMENT ITEM
// ======================================================

model SettlementItem {
  id String @id @default(cuid())

  settlementId String
  settlement VendorSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  accountingEntryId String
  accountingEntry AccountingEntry @relation(fields: [accountingEntryId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([settlementId, accountingEntryId])
  @@index([accountingEntryId])
  @@index([settlementId])
}

// ======================================================
// TRACKING
// ======================================================

model Tracking {
  id String @id @default(cuid())

  shipmentId String
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  status ShipmentStatus

  location String

  message String

  createdBy String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([status])
}

// ======================================================
// RIDER LOCATION
// ======================================================

model RiderLocation {
  id Int @id @default(autoincrement())

  riderId Int
  rider Rider @relation(fields: [riderId], references: [id])

  latitude Float
  longitude Float

  createdAt DateTime @default(now())

  @@index([riderId])
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id Int @id @default(autoincrement())

  shipmentId String
  shipment Shipment @relation(fields: [shipmentId], references: [id])

  title String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([isRead])
}