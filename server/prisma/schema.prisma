generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  ADMIN
  STAFF
  VENDOR
  RIDER
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  PICKUP_DONE
  CANCELLED
}

enum ShipmentOrigin {
  VENDOR
  STAFF
}

enum DeliveryZone {
  INSIDE_VALLEY
  OUTSIDE_VALLEY
}

enum ShipmentStatus {
  CREATED
  IN_WAREHOUSE
  ASSIGNED_TO_RIDER
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

enum PackageType {
  DOCUMENT
  PARCEL
  BOX
  ELECTRONICS
  CLOTHING
  FOOD
  FRAGILE
  OTHER
}

enum PaymentType {
  PREPAID
  COD
}

// ======================================================
// USER
// ======================================================

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role
  isActive Boolean @default(true)
  vendor Vendor?
  rider  Rider?
  staff  Staff?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// VENDOR
// ======================================================

model Vendor {
  id Int @id @default(autoincrement())

  companyName String
  contactId   String
  location    String

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments Shipment[]
  pickups   Pickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// STAFF
// ======================================================

model Staff {
  id Int @id @default(autoincrement())

  phone          String
  profilePicture String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdShipments Shipment[] @relation("CreatedByStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// RIDER
// ======================================================

model Rider {
  id Int @id @default(autoincrement())

  phone          String
  profilePicture String?

  latitude  Float?
  longitude Float?

  isAvailable Boolean @default(true)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shipments Shipment[]

  locations RiderLocation[]

  // Pickups assigned to this rider
  pickups Pickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// PICKUP
// ======================================================

model Pickup {
  id Int @id @default(autoincrement())

  totalPackages Int

  pickupAddress String
  pickupPhone   String

  // REQUESTED -> ASSIGNED -> PICKUP_DONE
  // REQUESTED -> CANCELLED
  // ASSIGNED  -> CANCELLED
  status PickupStatus @default(REQUESTED)

  notes String?

  // ====================================================
  // VENDOR
  // ====================================================

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // ====================================================
  // RIDER
  // ====================================================

  // Null when pickup is REQUESTED
  // Contains rider ID when ASSIGNED/PICKUP_DONE
  riderId Int?
  rider   Rider? @relation(fields: [riderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([riderId])
}

// ======================================================
// LOCATION
// ======================================================

model Location {
  id Int @id @default(autoincrement())

  name String @unique

  zone DeliveryZone

  rates LocationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// DELIVERY TYPE
// ======================================================

model DeliveryType {
  id Int @id @default(autoincrement())

  name String @unique

  rates LocationRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// LOCATION RATE
// ======================================================

model LocationRate {
  id Int @id @default(autoincrement())

  locationId Int
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  deliveryTypeId Int
  deliveryType   DeliveryType @relation(fields: [deliveryTypeId], references: [id], onDelete: Cascade)

  price Float

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, deliveryTypeId])
}

// ======================================================
// WAREHOUSE
// ======================================================

model Warehouse {
  id Int @id @default(autoincrement())

  name String
  city String

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CARRIER
// ======================================================

model Carrier {
  id Int @id @default(autoincrement())

  name  String
  phone String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SHIPMENT
// ======================================================

model Shipment {
  id String @id @default(cuid())

  trackingNumber String @unique

  receiverName    String
  receiverPhone   String
  receiverAddress String

  packageType PackageType
  weight      Float

  paymentType PaymentType @default(PREPAID)
  codAmount   Float       @default(0)

  shippingCharge Float

  notes  String?
  qrCode String?

  // ====================================================
  // WORKFLOW
  // ====================================================

  origin ShipmentOrigin

  deliveryZone DeliveryZone?

  status ShipmentStatus @default(CREATED)

  // ====================================================
  // VENDOR
  // ====================================================

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // ====================================================
  // STAFF WHO CREATED SHIPMENT
  // ====================================================

  createdByStaffId Int?
  createdByStaff   Staff? @relation("CreatedByStaff", fields: [createdByStaffId], references: [id])

  // ====================================================
  // RIDER
  // ====================================================

  riderId Int?
  rider   Rider? @relation(fields: [riderId], references: [id])

  // ====================================================
  // CURRENT WAREHOUSE
  // ====================================================

  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // ====================================================
  // OUTSIDE VALLEY CARRIER
  // ====================================================

  carrierId Int?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])

  // ====================================================
  // SHIPPING RATE
  // ====================================================

  locationRateId Int
  locationRate   LocationRate @relation(fields: [locationRateId], references: [id])

  // ====================================================
  // TRACKING
  // ====================================================

  trackings Tracking[]

  // ====================================================
  // NOTIFICATIONS
  // ====================================================

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([riderId])
  @@index([warehouseId])
  @@index([carrierId])
}

// ======================================================
// TRACKING HISTORY
// ======================================================

model Tracking {
  id String @id @default(cuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status ShipmentStatus

  location String

  message String

  createdBy String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
}

// ======================================================
// RIDER LOCATION
// ======================================================

model RiderLocation {
  id Int @id @default(autoincrement())

  riderId Int
  rider   Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float

  createdAt DateTime @default(now())

  @@index([riderId])
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id Int @id @default(autoincrement())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([shipmentId])
}